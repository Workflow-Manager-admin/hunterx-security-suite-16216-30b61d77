{
  "task_description": "{'component_name': 'Main Container for HunterX Security Suite', 'description': 'Primary container for HunterX Security Suite implementation: HunterX is a modular, user-friendly offensive security GUI app designed for bug bounty workflows. It integrates recon, scanning, exploitation, and reporting tools with a focus on extensibility, offline capability, and ease of use. The app leverages APIs (Shodan, Nuclei, H1/Bugcrowd, WhoisXML), supports plugin modules (Python/Rust WASM), and provides a workflow-centric dashboard for both beginners and advanced users.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Recon Dashboard",\n      "description": "Unified dashboard for subdomain enumeration (Amass, assetfinder), port scanning (masscan/nmap), and interactive visualization of discovered assets. Results are cached in SQLite for offline access.",\n      "isEnabled": true\n    },\n    {\n      "name": "Vulnerability Scanner",\n      "description": "Integrates Nuclei for automated vulnerability scanning with a template manager (YAML editor, severity tags), auto-updates, and custom payloads for XSS/SQLi.",\n      "isEnabled": true\n    },\n    {\n      "name": "Exploitation Toolkit",\n      "description": "Includes a Rust-based MITM proxy for request/response tampering, auto-decodes Base64/JWT, and a JS analyzer for detecting secrets via regex patterns.",\n      "isEnabled": true\n    },\n    {\n      "name": "Reporting Suite",\n      "description": "Markdown-based reporting with variable injection, export to PDF via headless Chromium, and customizable templates.",\n      "isEnabled": true\n    },\n    {\n      "name": "Bug Bounty Integrations",\n      "description": "Fetches and caches H1/Bugcrowd program scopes, supports filtering, and enforces scope boundaries with regex-based checks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Offline Mode",\n      "description": "Local caching of Shodan/Whois data with a 7-day TTL for offline recon and reporting.",\n      "isEnabled": true\n    },\n    {\n      "name": "Wordlist Generator",\n      "description": "Extracts keywords from JS/HTML using TF-IDF for custom wordlist generation.",\n      "isEnabled": true\n    },\n    {\n      "name": "Traffic Diffing",\n      "description": "Compares HTTP requests/responses across scans to highlight changes and anomalies.",\n      "isEnabled": true\n    },\n    {\n      "name": "Plugin System",\n      "description": "Supports Python and Rust WASM plugins for extending recon, scanning, and reporting capabilities.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#1a1a2e",\n    "secondary": "#16213e",\n    "accent": "#e94560"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI is inspired by Burp Suite: a tabbed interface with clear navigation for Recon, Scan, Exploit, Report, and Integrations. Each tab features intuitive controls, real-time status, and visualizations (SVG maps, tables, editors). A dark mode is default, with large, accessible buttons and tooltips for beginners. The dashboard provides workflow guidance and quick access to core actions."\n}'}",
